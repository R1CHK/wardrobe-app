.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 图片 ---------- */
.gallery {
  width: 750rpx;
  height: 860rpx;
  background: #EDEBE4;
}

.gallery-img {
  width: 750rpx;
  height: 860rpx;
  display: block;
}

/* ---------- 信息 ---------- */
.body {
  position: relative;
  margin-top: -36rpx;
  padding: 36rpx 30rpx 60rpx;
  background: var(--bg);
  border-radius: 28rpx 28rpx 0 0;
}

.title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
  flex: 1;
  padding-right: 20rpx;
}

.price {
  font-family: "Songti SC", Georgia, serif;
  font-size: 40rpx;
  color: var(--ink);
  flex: none;
}

.price-yen {
  font-size: 26rpx;
  margin-right: 2rpx;
  color: var(--ink3);
}

.rows {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 6rpx 26rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.row:last-child {
  border-bottom: none;
}

.k {
  font-size: 26rpx;
  color: var(--ink3);
}

.v {
  font-size: 26rpx;
  color: var(--ink);
  max-width: 440rpx;
  text-align: right;
}

.placeholder {
  color: #B6B3A8;
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  margin-top: 34rpx;
}

.act {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

.act-hover {
  opacity: .75;
}

.act-edit {
  background: #4E6144;
  color: #fff;
  margin-right: 18rpx;
}

.act-del {
  background: transparent;
  color: var(--clay);
  border: 1rpx solid #E7D6C8;
}

/* ---------- 状态 ---------- */
.state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.state-mark {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  border-radius: 50%;
  background: #EDEBE4;
  color: var(--ink3);
  font-family: "Songti SC", Georgia, serif;
  font-size: 44rpx;
  margin-bottom: 28rpx;
}

.state-text {
  font-size: 26rpx;
  color: var(--ink3);
  text-align: center;
  line-height: 1.7;
}

.state-btn {
  margin-top: 36rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 99rpx;
  border: 1rpx solid var(--line);
  color: var(--ink2);
  font-size: 25rpx;
}

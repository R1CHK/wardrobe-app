.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding: 44rpx 24rpx 26rpx;
}

.hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--sage);
  font-weight: 600;
  margin-bottom: 14rpx;
}

.hero-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink3);
}

/* ---------- 分类 ---------- */
.cats {
  white-space: nowrap;
  padding: 0 24rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 99rpx;
  font-size: 24rpx;
  color: var(--ink2);
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  line-height: 1.6;
}

.cat.on {
  background: #4E6144;
  border-color: #4E6144;
  color: #FFFFFF;
  font-weight: 500;
}

/* ---------- 网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.item {
  width: 342rpx;
  margin-right: 18rpx;
  margin-bottom: 28rpx;
}

.item:nth-child(2n) {
  margin-right: 0;
}

.item-hover {
  opacity: .82;
}

.item-img-wrap {
  position: relative;
  width: 100%;
  height: 448rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #EDEBE4;
}

.item-img {
  width: 100%;
  height: 100%;
  display: block;
}

.item-price {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(27, 27, 24, .62);
  color: #fff;
  font-size: 20rpx;
  letter-spacing: .5rpx;
}

.item-title {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 骨架 ---------- */
.skel {
  width: 342rpx;
  height: 448rpx;
  margin-right: 18rpx;
  margin-bottom: 28rpx;
  border-radius: 14rpx;
  background: #EDEBE4;
  animation: pulse 1.4s ease-in-out infinite;
}

.skel:nth-child(2n) {
  margin-right: 0;
}

@keyframes pulse {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 110rpx 60rpx 60rpx;
  text-align: center;
}

.empty-mark {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: #EDEBE4;
  color: var(--ink3);
  font-family: "Songti SC", Georgia, serif;
  font-size: 48rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: var(--ink3);
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: inline-block;
  padding: 0 56rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 99rpx;
  background: #4E6144;
  color: #fff;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

/* ---------- 加载更多 ---------- */
.loadmore {
  text-align: center;
  padding: 20rpx 0 30rpx;
  font-size: 22rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 56rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #4E6144;
  box-shadow: 0 10rpx 28rpx rgba(78, 97, 68, .32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.fab-hover {
  transform: scale(.94);
}

.fab-bar {
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
}

.fab-bar-h {
  width: 36rpx;
  height: 4rpx;
}

.fab-bar-v {
  width: 4rpx;
  height: 36rpx;
}

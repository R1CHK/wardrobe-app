/**
 * 全局样式与设计变量
 * 配色：暖白底 + 墨色字 + 鼠尾草绿点缀，尽量克制
 */
page {
  --bg: #F7F6F2;
  --card: #FFFFFF;
  --ink: #1B1B18;
  --ink2: #48483F;
  --ink3: #8B8B80;
  --line: #E2E0D8;
  --line-soft: #EFEEE8;
  --sage: #5C7151;
  --sage-soft: #EDF0E7;
  --clay: #A5673F;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 通用按钮 ---------- */
.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.btn-primary {
  background: var(--sage);
  color: #fff;
}

.btn-primary.disabled {
  background: #C9CFC3;
  color: #F2F4EF;
}

.btn-ghost {
  background: transparent;
  color: var(--ink2);
  border: 1rpx solid var(--line);
}

.btn-danger {
  background: transparent;
  color: var(--clay);
  border: 1rpx solid #E7D6C8;
}

/* ---------- 通用文本 ---------- */
.t-hint {
  font-size: 24rpx;
  color: var(--ink3);
}

.t-mono {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

/* ---------- 通用容器 ---------- */
.card {
  background: var(--card);
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}
